# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repo.

# Entorno: development | test | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# Nombre del estudio que se muestra en la API y la documentación
APP_NAME=Estudio Xolos

# Orígenes permitidos por CORS (dominios del dashboard), separados por coma, sin "/" final
CORS_ORIGIN=http://localhost:4200

# Cadena de conexión a MongoDB (obligatoria). Mejor SIN nombre de base en la ruta:
# la base se indica aparte con MONGODB_DB.
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# Base de datos (obligatoria, sin valor por defecto). La API y los scripts trabajan SIEMPRE
# sobre esta base, aunque el cluster de Atlas sea compartido con otros proyectos.
# Si la URI trae un nombre de base distinto, la API no arranca.
MONGODB_DB=xolos_analytics

# Secreto para firmar los JWT del dashboard (obligatorio para la API; mínimo 32 caracteres).
# Los scripts no lo necesitan. Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Saltos de proxy delante de la API (Render/Railway = 1; local sin proxy = 0).
# Sirve para que el rate limit vea la IP real del jugador.
TRUST_PROXY=0

# Límites por minuto. Valores de producción: 300 por IP y 1000 por API key en la ingesta,
# 600 por IP en /salud y /docs. Solo se suben para la prueba de carga.
RATE_LIMIT_INGESTA_IP=300
RATE_LIMIT_INGESTA_KEY=1000
RATE_LIMIT_PUBLICO_IP=600
# Intentos fallidos de login por IP cada 15 minutos.
RATE_LIMIT_LOGIN_IP=5
# Intentos (todos, no solo los fallidos) de validar o aceptar una invitación por IP cada 15 minutos.
RATE_LIMIT_INVITACION_IP=10

# Origen del dashboard para armar los enlaces de invitación (<origen>/invitacion#token=...).
# Vacío = el primer origen de CORS_ORIGIN. En producción: el dominio de Vercel, sin "/" final.
DASHBOARD_URL=

# Solo para el script crear-admin (primer admin, sin registro público).
# Mínimo 12 caracteres. Borra ADMIN_PASSWORD del .env después de crear el admin.
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador
