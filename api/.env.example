# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repo.

# Entorno: development | test | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# Nombre del estudio que se muestra en la API y la documentación
APP_NAME=Estudio Xolos

# Orígenes permitidos por CORS (dominio del dashboard), separados por coma
CORS_ORIGIN=http://localhost:4200

# Cadena de conexión a MongoDB (obligatoria). Mejor SIN nombre de base en la ruta:
# la base se indica aparte con MONGODB_DB.
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# Base de datos (obligatoria, sin valor por defecto). La API y los scripts trabajan SIEMPRE
# sobre esta base, aunque el cluster de Atlas sea compartido con otros proyectos.
# Si la URI trae un nombre de base distinto, la API no arranca.
MONGODB_DB=xolos_analytics

# Solo para el script crear-admin (primer admin, sin registro público).
# Mínimo 12 caracteres. Borra ADMIN_PASSWORD del .env después de crear el admin.
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador
