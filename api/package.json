{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "description": "API de la plataforma de métricas multi-juego",
  "main": "dist/server.js",
  "engines": {
    "node": "22.22.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "postman": "newman run ../postman/coleccion.postman_collection.json -e ../postman/entorno-local.postman_environment.json",
    "crear-admin": "tsx ../scripts/crear-admin.ts",
    "crear-juego": "tsx ../scripts/crear-juego.ts",
    "rotar-api-key": "tsx ../scripts/rotar-api-key.ts",
    "revocar-api-key": "tsx ../scripts/revocar-api-key.ts",
    "limpiar-seed": "tsx ../scripts/limpiar-seed.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "newman": "^6.2.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
