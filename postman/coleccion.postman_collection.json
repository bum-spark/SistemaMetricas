              ],
              "path": [
                "eventos"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{{loteParcial}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Arma eventos con los campos comunes de ESQUEMA_EVENTOS.md §2 (UUID v4 de {{$guid}}).",
                  "const uuid = () => pm.variables.replaceIn('{{$guid}}');",
                  "const base = Date.now() - 60 * 1000;",
                  "let secuencia = 0;",
                  "const evento = (tipo, data, extra) => Object.assign({",
                  "  eventoId: uuid(),",
                  "  juegoId: pm.environment.get('juegoId'),",
                  "  playerId: pm.environment.get('playerId'),",
                  "  sessionId: pm.environment.get('sessionId'),",
                  "  secuencia: ++secuencia,",
                  "  timestamp: new Date(base + secuencia * 1000).toISOString(),",
                  "  buildVersion: '1.0.0',",
                  "  plataforma: 'windows',",
                  "  versionEsquema: 1,",
                  "  tipo: tipo,",
                  "  data: data || {}",
                  "}, extra || {});",
                  "",
                  "pm.environment.set('loteParcial', JSON.stringify([",
                  "  evento('pausa', { duracionMs: 3000 }),",
                  "  evento('muerte', { nivelId: 'casa_abandonada', intento: 1, causa: 'agua', x: 1, y: 2 }),",
                  "  evento('inactividad', { duracionMs: 60000, nivelId: 'casa_abandonada' })",
                  "]));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201: 2 aceptados y el índice 1 rechazado', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const r = pm.response.json();",
                  "  pm.expect(r.aceptados).to.eql(2);",
                  "  pm.expect(r.rechazados).to.have.lengthOf(1);",
                  "  pm.expect(r.rechazados[0]).to.include({ indice: 1, codigo: 'VALIDACION_FALLIDA' });",
                  "  pm.expect(r.rechazados[0].mensaje).to.include('agua');",
                  "});"
                ]
              }
            }
          ]
        },
