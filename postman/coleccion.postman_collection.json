          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Un jugador anónimo nuevo por corrida (en Unity sale de PlayerPrefs).",
                  "pm.environment.set('playerId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 con sessionId UUID v4', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const sessionId = pm.response.json().sessionId;",
                  "  pm.expect(sessionId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/);",
                  "  pm.environment.set('sessionId', sessionId);",
                  "});"
                ]
              }
            }
          ]
        },
