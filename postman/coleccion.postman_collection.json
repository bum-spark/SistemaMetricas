            "description": "Crea (o actualiza) el jugador y una sesión nueva. Guarda sessionId en el entorno.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"juegoId\": \"{{juegoId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"buildVersion\": \"1.0.0\",\n  \"plataforma\": \"windows\",\n  \"consentimiento\": true\n}",
              "options": {
