                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json()).to.eql({ aceptados: 11, rechazados: [] });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Lote con un evento inválido (aceptación parcial)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
