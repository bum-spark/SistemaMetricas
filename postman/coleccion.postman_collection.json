    {
      "name": "Ingesta — eventos",
      "item": [
        {
          "name": "Lote válido (partida de ejemplo, 11 eventos)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/eventos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "eventos"
              ]
            },
            "description": "La partida corta de ESQUEMA_EVENTOS.md §11. Requiere haber corrido 'Crear sesión'.",
            "body": {
              "mode": "raw",
              "raw": "{{loteEventos}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Arma eventos con los campos comunes de ESQUEMA_EVENTOS.md §2 (UUID v4 de {{$guid}}).",
                  "const uuid = () => pm.variables.replaceIn('{{$guid}}');",
                  "const base = Date.now() - 60 * 1000;",
                  "let secuencia = 0;",
                  "const evento = (tipo, data, extra) => Object.assign({",
                  "  eventoId: uuid(),",
                  "  juegoId: pm.environment.get('juegoId'),",
                  "  playerId: pm.environment.get('playerId'),",
                  "  sessionId: pm.environment.get('sessionId'),",
                  "  secuencia: ++secuencia,",
                  "  timestamp: new Date(base + secuencia * 1000).toISOString(),",
                  "  buildVersion: '1.0.0',",
                  "  plataforma: 'windows',",
                  "  versionEsquema: 1,",
                  "  tipo: tipo,",
                  "  data: data || {}",
                  "}, extra || {});",
                  "",
                  "const lote = [",
                  "  evento('sesion_inicio'),",
                  "  evento('nivel_inicio', { nivelId: 'casa_abandonada', intento: 1 }),",
                  "  evento('tutorial_completado', { duracionMs: 55000 }),",
                  "  evento('logro', { logroId: 'tutorial_superado' }),",
                  "  evento('muerte', { nivelId: 'casa_abandonada', intento: 1, causa: 'fantasma', x: 12.5, y: -3.2 }),",
                  "  evento('nivel_fin', { nivelId: 'casa_abandonada', intento: 1, resultado: 'muerte', duracionMs: 95000 }),",
                  "  evento('nivel_inicio', { nivelId: 'casa_abandonada', intento: 2 }),",
                  "  evento('flor_recogida', { nivelId: 'casa_abandonada', duracionMs: 150000 }),",
                  "  evento('nivel_fin', { nivelId: 'casa_abandonada', intento: 2, resultado: 'completado', duracionMs: 150000 }),",
                  "  evento('logro', { logroId: 'casa_abandonada_completada' }),",
                  "  evento('sesion_fin', { motivo: 'menu_salir' })",
                  "];",
                  "// Se guarda para reenviarlo tal cual en 'Reenviar el mismo lote'.",
                  "pm.environment.set('loteEventos', JSON.stringify(lote));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 con los 11 aceptados y sin rechazos', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json()).to.eql({ aceptados: 11, rechazados: [] });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reenviar el mismo lote (duplicados)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
