                  "// Arma eventos con los campos comunes de ESQUEMA_EVENTOS.md §2 (UUID v4 de {{$guid}}).",
                  "const uuid = () => pm.variables.replaceIn('{{$guid}}');",
                  "const base = Date.now() - 60 * 1000;",
                  "let secuencia = 0;",
                  "const evento = (tipo, data, extra) => Object.assign({",
                  "  eventoId: uuid(),",
                  "  juegoId: pm.environment.get('juegoId'),",
                  "  playerId: pm.environment.get('playerId'),",
                  "  sessionId: pm.environment.get('sessionId'),",
                  "  secuencia: ++secuencia,",
